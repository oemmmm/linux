[Unit]
Description=планировщик scx_lavd
Documentation=https://github.com/oemmmm/linux/tree/main
ConditionKernelVersion=*-leksos-game
ConditionPathExists=/usr/bin/scx_lavd
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/scx_lavd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

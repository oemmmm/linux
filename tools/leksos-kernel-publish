#!/bin/bash
set -euo pipefail

conf=${XDG_CONFIG_HOME:-$HOME/.config}/leksos/publish.conf
# shellcheck source=/dev/null
[[ -f $conf ]] && . "$conf"

key=${LEKSOS_KEY:-}
repo=${LEKSOS_REPO:-$HOME/repo/x86_64}
db=$repo/leksos.db.tar.zst
github=https://github.com/oemmmm/linux

flavors=("$@")
(( ${#flavors[@]} )) || flavors=(desktop game server rt lts)

tools=(bsdtar curl repo-add sha256sum)
if [[ -n $key ]]; then
	tools+=(gpg)
else
	echo "LEKSOS_KEY не задан, без подписи" >&2
fi
for tool in "${tools[@]}"; do
	command -v "$tool" >/dev/null || { echo "нет программы $tool" >&2; exit 1; }
done
[[ -f $db ]] || { echo "нет базы репозитория: $db" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

curl -fsSL "https://raw.githubusercontent.com/oemmmm/linux/main/PKGBUILD" -o "$tmp/PKGBUILD"
var() { sed -n "s/^$1=//p" "$tmp/PKGBUILD"; }

# Что уже записано в базе: имя-версия-сборка, по строке на пакет.
# Решаем по базе, а не по файлам в папке: файл мог остаться от
# прерванного запуска и так и не попасть в базу.
indb=$(bsdtar -tf "$db" | sed -n 's#/desc$##p')

added=()
failed=0
for flavor in "${flavors[@]}"; do
	case $flavor in
		lts) tag=v$(var _lts)-leksos$(var _lts_rev) ;;
		desktop | game | server | rt) tag=v$(var _stable)-leksos$(var _stable_rev) ;;
		*) echo "неизвестный вид ядра: $flavor" >&2; exit 1 ;;
	esac
	sums=$tmp/sha256sums-$flavor.txt
	code=$(curl -sL -o "$sums" -w '%{http_code}' \
		"$github/releases/download/$tag/sha256sums-$flavor.txt") || code=000
	case $code in
		200) ;;
		404)
			echo "$flavor: в релизе $tag пакетов пока нет"
			continue
			;;
		*)
			echo "$flavor: не удалось скачать суммы из $tag (код $code), запустите ещё раз позже" >&2
			failed=1
			continue
			;;
	esac
	while read -r sum file; do
		if grep -qxF "${file%-*.pkg.tar.*}" <<<"$indb"; then
			echo "$file: уже в репозитории"
			continue
		fi
		if [[ -e $repo/$file ]] && echo "$sum  $repo/$file" | sha256sum -c --quiet - 2>/dev/null; then
			echo "$file: уже скачан, добавляю в базу"
		else
			echo "$file"
			curl -fL --progress-bar "$github/releases/download/$tag/$file" -o "$tmp/$file"
			echo "$sum  $tmp/$file" | sha256sum -c --quiet -
			mv "$tmp/$file" "$repo/"
		fi
		if [[ -n $key ]]; then
			gpg --yes --local-user "$key" --detach-sign --no-armor -o "$repo/$file.sig" "$repo/$file"
		fi
		added+=("$repo/$file")
	done < "$sums"
done

if (( ${#added[@]} )); then
	sign=()
	[[ -n $key ]] && sign=(--sign --key "$key")
	repo-add "${sign[@]}" -R "$db" "${added[@]}"
else
	echo "новых пакетов нет"
fi

if [[ -n ${LEKSOS_RSYNC:-} ]]; then
	rsync -rltv --delay-updates --delete-after "$repo/" "$LEKSOS_RSYNC"
else
	echo "LEKSOS_RSYNC не задан"
fi

exit "$failed"

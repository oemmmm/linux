#!/bin/bash
# Забирает собранные ядра LeksOS из релизов GitHub, проверяет суммы,
# подписывает своим ключом и добавляет в репозиторий [leksos], а потом
# выкладывает репозиторий на сервер. Запускается на вашем компьютере:
# ключ подписи никуда не уходит.
#
#   leksos-kernel-publish [вид...]     по умолчанию все: desktop game server rt lts
#
# Настройки — переменные окружения или файл ~/.config/leksos/publish.conf:
#   LEKSOS_KEY    отпечаток ключа подписи; не задан — пакеты добавляются
#                 без подписи (пока у репозитория SigLevel = Optional)
#   LEKSOS_REPO   каталог репозитория, по умолчанию ~/repo/x86_64
#   LEKSOS_RSYNC  куда выкладывать, например user@server:/srv/leksos/x86_64/
#                 (не задано — только у себя)
set -euo pipefail

conf=${XDG_CONFIG_HOME:-$HOME/.config}/leksos/publish.conf
# shellcheck source=/dev/null
[[ -f $conf ]] && . "$conf"

key=${LEKSOS_KEY:-}
repo=${LEKSOS_REPO:-$HOME/repo/x86_64}
db=$repo/leksos.db.tar.zst
github=https://github.com/oemmmm/linux

flavors=("$@")
(( ${#flavors[@]} )) || flavors=(desktop game server rt lts)

tools=(curl repo-add sha256sum)
if [[ -n $key ]]; then
	tools+=(gpg)
else
	echo "LEKSOS_KEY не задан: пакеты попадут в репозиторий без подписи" >&2
fi
for tool in "${tools[@]}"; do
	command -v "$tool" >/dev/null || { echo "нет программы $tool" >&2; exit 1; }
done
[[ -f $db ]] || { echo "нет базы репозитория: $db" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Какие метки сейчас собираются — из PKGBUILD ветки main.
curl -fsSL "https://raw.githubusercontent.com/oemmmm/linux/main/PKGBUILD" -o "$tmp/PKGBUILD"
var() { sed -n "s/^$1=//p" "$tmp/PKGBUILD"; }

added=()
for flavor in "${flavors[@]}"; do
	case $flavor in
		lts) tag=v$(var _lts)-leksos$(var _lts_rev) ;;
		desktop | game | server | rt) tag=v$(var _stable)-leksos$(var _stable_rev) ;;
		*) echo "неизвестный вид ядра: $flavor" >&2; exit 1 ;;
	esac
	sums=$tmp/sha256sums-$flavor.txt
	if ! curl -fsSL "$github/releases/download/$tag/sha256sums-$flavor.txt" -o "$sums"; then
		echo "$flavor: в релизе $tag пакетов пока нет — сборка ещё идёт или не удалась"
		continue
	fi
	while read -r sum file; do
		if [[ -e $repo/$file ]]; then
			echo "$file: уже в репозитории"
			continue
		fi
		echo "$file"
		curl -fL --progress-bar "$github/releases/download/$tag/$file" -o "$tmp/$file"
		echo "$sum  $tmp/$file" | sha256sum -c --quiet -
		if [[ -n $key ]]; then
			gpg --yes --local-user "$key" --detach-sign --no-armor -o "$tmp/$file.sig" "$tmp/$file"
			mv "$tmp/$file.sig" "$repo/"
		fi
		mv "$tmp/$file" "$repo/"
		added+=("$repo/$file")
	done < "$sums"
done

if (( ! ${#added[@]} )); then
	echo "нового нет"
	exit 0
fi

sign=()
[[ -n $key ]] && sign=(--sign --key "$key")
repo-add "${sign[@]}" -R "$db" "${added[@]}"

if [[ -n ${LEKSOS_RSYNC:-} ]]; then
	rsync -rltv --delay-updates --delete-after "$repo/" "$LEKSOS_RSYNC"
else
	echo "LEKSOS_RSYNC не задан: репозиторий обновлён только здесь, в $repo"
fi

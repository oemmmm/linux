#!/bin/bash
set -euo pipefail

if (( $# < 1 )); then
	echo "use $0" >&2
	exit 2
fi

here=$(cd "$(dirname "$0")/.." && pwd)
tree=$(realpath "$1")
old=${2:-/proc/config.gz}
build=$(mktemp -d)
trap 'rm -rf "$build"' EXIT

k() { make -s -C "$tree" O="$build/$1" "${@:2}"; }

mkdir "$build/base"
if [[ $old == *.gz ]]; then
	zcat "$old" > "$build/base/.config"
else
	cp "$old" "$build/base/.config"
fi

k base listnewconfig > "$build/new.txt"
echo "new options $(wc -l < "$build/new.txt")"
k base olddefconfig
grep -E '=n$' "$build/new.txt" | cut -d= -f1 |
	grep -v -E 'TEST|DEBUG|BENCHMARK|KUNIT|SELFTEST|SAMPLE|EXAMPLE|WERROR|TRACE' |
	sed 's/$/=m/' > "$build/modules.txt" || true
cat "$build/modules.txt" >> "$build/base/.config"
k base olddefconfig 2>/dev/null

echo "turned off by modules"
while IFS='=' read -r sym _; do
	grep -q "^$sym=m$" "$build/base/.config" && echo "  $sym"
done < "$build/modules.txt"

k base savedefconfig
cp "$build/base/defconfig" "$tree/arch/x86/configs/leksos_defconfig"
echo "arch/x86/configs/leksos_defconfig"

status=0
for fragment in "$tree"/kernel/configs/leksos-*.config; do
	flavor=$(basename "$fragment" .config)
	flavor=${flavor#leksos-}
	mkdir "$build/$flavor"
	k "$flavor" leksos_defconfig leksos.config "leksos-$flavor.config" >/dev/null
	printf '%s: ' "$flavor"
	bash "$here/check-config" "$build/$flavor/.config" \
		"$tree/kernel/configs/leksos.config" "$fragment" || status=1
done
exit $status

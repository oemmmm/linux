#!/bin/bash
set -euo pipefail

flavor=$1
tree=$2
out=$3
here=$(cd "$(dirname "$0")/.." && pwd)
work=/build

echo "::group::"
pacman -Syu --noconfirm --needed \
	base-devel bc cpio gettext git libelf pahole perl python \
	rust rust-bindgen rust-src tar xz zstd qemu-system-x86
echo "::endgroup::"

id builder >/dev/null 2>&1 || useradd -m builder
mkdir -p "$work" "$out"
cp "$here"/{PKGBUILD,check-config,leksos-game.service,leksos-game-scx.service} "$work"/
chown -R builder: "$work" "$out"

echo "::group:: $flavor"
cd "$work"
sudo -u builder env \
	LEKSOS_FLAVOR="$flavor" \
	LEKSOS_TREE="$tree" \
	PKGDEST="$out" \
	MAKEFLAGS="-j$(nproc)" \
	makepkg --noconfirm
echo "::endgroup::"

"$here/ci/boot-test" "$work/src/linux"

chmod -R a+rwX "$out"
ls -l "$out"

#!/bin/bash
# Ищет новые выпуски ядра, переносит на них ветки LeksOS и ставит метки.
#
#   ci/update [проверить|собрать|пересобрать]
#
#   проверить    (по умолчанию) вышла новая версия ядра или в ветке
#                leksos/<серия> появились коммиты → новая метка и сборка
#   собрать      собрать текущие метки, ничего не меняя (первая сборка или
#                повтор после сбоя)
#   пересобрать  новая метка (номер сборки +1), даже если ничего не менялось
#
# Запускается в GitHub Actions в клоне ветки main; нужен GH_TOKEN.
# Пишет в $GITHUB_OUTPUT build=true|false и flavors=[...] — какие виды
# ядра собирать.
set -euo pipefail

mode=${1:-проверить}
here=$(cd "$(dirname "$0")/.." && pwd)
upstream=${LEKSOS_UPSTREAM:-https://github.com/gregkh/linux}
repo=${GITHUB_REPOSITORY:-JustAMannn/linux}
output=${GITHUB_OUTPUT:-/dev/stdout}

case $mode in
	проверить | собрать | пересобрать) ;;
	*) echo "неизвестный режим: $mode" >&2; exit 2 ;;
esac

var() { sed -n "s/^$1=//p" "$here/PKGBUILD"; }
setvar() { sed -i "s/^$1=.*/$1=$2/" "$here/PKGBUILD"; }
g() { git -C "$here" "$@"; }

# Последний выпуск серии: latest 7.3 → 7.3.2 (или 7.3, если точечных ещё нет).
latest() {
	git ls-remote --tags --refs "$upstream" "refs/tags/v$1" "refs/tags/v$1.*" |
		sed 's#.*refs/tags/v##' | grep -E '^[0-9]+(\.[0-9]+)*$' | sort -V | tail -n1
}

g config user.name 'github-actions[bot]'
g config user.email '41898282+github-actions[bot]@users.noreply.github.com'

flavors=()
changes=()

# update <переменная версии> <переменная номера> <виды ядра...>
update() {
	local vervar=$1 revvar=$2
	shift 2
	local cur rev series branch tagged new tip old tag wt
	cur=$(var "$vervar")
	rev=$(var "$revvar")
	series=$(cut -d. -f1,2 <<<"$cur")
	branch=leksos/$series
	tagged=v$cur-leksos$rev

	if [[ $mode == собрать ]]; then
		echo "серия $series: сборка $tagged"
		flavors+=("$@")
		return
	fi

	new=$(latest "$series")
	if [[ -z $new ]]; then
		echo "::error::в $upstream нет выпусков серии $series"
		exit 1
	fi

	g fetch -q --depth=100 origin \
		"+refs/heads/$branch:refs/remotes/origin/$branch" \
		"+refs/tags/$tagged:refs/tags/$tagged"
	tip=$(g rev-parse "refs/remotes/origin/$branch")
	old=$tip

	if [[ $new != "$cur" ]]; then
		echo "серия $series: $cur → $new"
		# Ветку можно отправить из неглубокого клона, только если в форке уже
		# есть коммит нового выпуска, поэтому сначала подтягиваем в форк
		# ветку стабильной серии.
		gh api -X POST "repos/$repo/merge-upstream" -f branch="linux-$series.y" >/dev/null ||
			echo "::warning::не удалось обновить linux-$series.y из $upstream"
		g fetch -q --depth=1 "$upstream" \
			"+refs/tags/v$cur:refs/tags/v$cur" \
			"+refs/tags/v$new:refs/tags/v$new"
		wt=$(mktemp -d)
		g worktree add -q --detach "$wt" "$tip"
		if ! git -C "$wt" rebase -q --onto "v$new" "v$cur"; then
			git -C "$wt" rebase --abort || true
			echo "::error::правки LeksOS не переносятся на $new сами: перенесите ветку $branch вручную (README, «Новая версия ядра»)"
			exit 1
		fi
		tip=$(git -C "$wt" rev-parse HEAD)
		g worktree remove --force "$wt"
		g push -q --force-with-lease="refs/heads/$branch:$old" origin "$tip:refs/heads/$branch"
		cur=$new
		rev=1
	elif [[ $mode == пересобрать || $tip != "$(g rev-parse "refs/tags/$tagged^{commit}")" ]]; then
		rev=$((rev + 1))
		echo "серия $series: новая сборка $cur-leksos$rev"
	else
		echo "серия $series: $tagged, ничего нового"
		return
	fi

	tag=v$cur-leksos$rev
	g tag "$tag" "$tip"
	g push -q origin "refs/tags/$tag"
	setvar "$vervar" "$cur"
	setvar "$revvar" "$rev"
	changes+=("$tag")
	flavors+=("$@")
}

update _stable _stable_rev desktop game server rt
update _lts _lts_rev lts

# Новая серия (например, 7.4) переносится вручную: там нужно проверить
# новые опции. Здесь только напоминание.
stable_series=$(cut -d. -f1,2 <<<"$(var _stable)")
newest=$(git ls-remote --tags --refs "$upstream" 'refs/tags/v*' |
	sed -n 's#.*refs/tags/v\([0-9]*\.[0-9]*\)$#\1#p' | sort -V | tail -n1)
if [[ -n $newest && $(printf '%s\n' "$stable_series" "$newest" | sort -V | tail -n1) != "$stable_series" ]]; then
	echo "::warning::вышло ядро $newest: создайте ветку leksos/$newest (README, «Новая версия ядра»)"
fi

if (( ${#changes[@]} )); then
	g commit -q -am "ядра: ${changes[*]}"
	g push -q origin HEAD:refs/heads/main
fi

build=false
json=
if (( ${#flavors[@]} )); then
	build=true
	json=$(printf '"%s",' "${flavors[@]}")
fi
{
	echo "build=$build"
	echo "flavors=[${json%,}]"
} >> "$output"

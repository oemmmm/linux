# LeksOS: общие настройки всех ядер LeksOS.
#
# Настройки ядра собираются так:
#   make leksos_defconfig leksos.config leksos-<вид>.config
# где <вид> — desktop, game, server или rt. Каждая строка этого файла и
# файла вида проверяется после сборки настроек (check-config в ветке
# main): если ядро не приняло значение, сборка останавливается.

## Имя
CONFIG_DEFAULT_HOSTNAME="leksos"
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

## Настройки собранного ядра видны в /proc/config.gz
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

## lks: программы из слоёв запускаются в bubblewrap без root
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y

## BPF и сменные планировщики sched_ext (scx_lavd, scx_bpfland и другие)
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y

## Память: MGLRU, сжатие в памяти (zram, zswap)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM=m
CONFIG_ZSWAP=y

## Wine и Proton
CONFIG_NTSYNC=m

## Вытеснение можно сменить при загрузке: preempt=full или preempt=lazy
CONFIG_PREEMPT_DYNAMIC=y

## Rust: драйверы на Rust и, позже, lefs
CONFIG_RUST=y

## Сжатие ядра и модулей
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS_ZSTD=y

## Защита от уязвимостей процессора включена.
## Выключить её можно параметром загрузки mitigations=off.
CONFIG_CPU_MITIGATIONS=y

## Модули подписываются ключом сборки; модули DKMS без подписи тоже грузятся
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
# CONFIG_MODULE_SIG_FORCE is not set

## Файловые системы: установленная система, live-образ, флешки и диски Windows
CONFIG_BTRFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m
CONFIG_EROFS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m

## Видеокарты: простой вывод до загрузки драйвера и основные драйверы.
## nouveau — для NVIDIA без своего драйвера (в том числе старых, вроде GTX 560).
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m

## Экран при сбое ядра. Текст ошибки по умолчанию; QR-код с ним —
## параметром загрузки drm.panic_screen=qr_code.
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y

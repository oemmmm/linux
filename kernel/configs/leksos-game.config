# LeksOS: игровое ядро (linux-leksos-game).
# Применяется после leksos_defconfig и leksos.config.
#
# Кроме настроек ниже, пакет ставит две службы, которые работают только
# под этим ядром: планировщик scx_lavd (если установлен scx-scheds) и
# отключение замедления программ, делающих split lock.

## Таймер 1000 Гц: меньше задержка ввода и кадров
CONFIG_HZ_1000=y

## Полное вытеснение
CONFIG_PREEMPT=y

## Крупные страницы памяти для всех программ: играм и эмуляторам
## с большими объёмами памяти так быстрее
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y

# LeksOS: запасное ядро на ветке с долгой поддержкой (linux-leksos-lts).
# Настроено как обычное ядро. Применяется после leksos_defconfig и
# leksos.config.

## Таймер 300 Гц: отзывчиво и бережёт батарею
CONFIG_HZ_300=y

## Полное вытеснение: система отзывчива под нагрузкой
CONFIG_PREEMPT=y

## Крупные страницы памяти только для программ, которые просят их сами
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# LeksOS: обычное ядро (linux-leksos) — работа, учёба, ноутбуки.
# Применяется после leksos_defconfig и leksos.config.

## Таймер 300 Гц: отзывчиво и бережёт батарею
CONFIG_HZ_300=y

## Полное вытеснение: система отзывчива под нагрузкой
CONFIG_PREEMPT=y

## Крупные страницы памяти только для программ, которые просят их сами:
## меньше лишнего расхода памяти на машинах с 4–8 ГБ
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

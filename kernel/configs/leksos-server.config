# LeksOS: серверное ядро (linux-leksos-server).
# Применяется после leksos_defconfig и leksos.config.

## Таймер 250 Гц и вытеснение lazy: больше пропускная способность
CONFIG_HZ_250=y
CONFIG_PREEMPT_LAZY=y

## Крупные страницы памяти только по запросу (так советуют базы данных)
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

## Сеть: BBR и очередь fq по умолчанию
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_FQ=y

## Без звука, Bluetooth, камер, ТВ-тюнеров и геймпадов
# CONFIG_SOUND is not set
# CONFIG_BT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_JOYDEV is not set

## Видео: встроенная графика Intel и AMD остаётся (аппаратное перекодирование
## видео), а также серверные (BMC) и виртуальные видеокарты
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_RADEON is not set
CONFIG_DRM_AST=m
CONFIG_DRM_MGAG200=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_QXL=m
CONFIG_DRM_BOCHS=m

## Усиленная защита памяти ядра
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_LEGACY_TIOCSTI is not set

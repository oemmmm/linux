#!/bin/bash
set -euo pipefail

if (( $# < 2 )); then
	echo "use: $0 .config add.config..." >&2
	exit 2
fi

config=$1
shift

parse() {
	local line
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $line =~ ^(CONFIG_[A-Za-z0-9_]+)=(.*)$ ]]; then
			printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
		elif [[ $line =~ ^#\ (CONFIG_[A-Za-z0-9_]+)\ is\ not\ set$ ]]; then
			printf '%s n\n' "${BASH_REMATCH[1]}"
		fi
	done < "$1"
}

declare -A want from have
for fragment in "$@"; do
	while read -r sym value; do
		want[$sym]=$value
		from[$sym]=${fragment##*/}
	done < <(parse "$fragment")
done
while read -r sym value; do
	have[$sym]=$value
done < <(parse "$config")

bad=0
while read -r sym; do
	expected=${want[$sym]}
	actual=${have[$sym]:-n}
	if [[ $expected != "$actual" ]]; then
		if (( ! bad )); then
			echo "kernel did not accept the settings:" >&2
		fi
		printf '  %s: excepted %s, actual %s (%s)\n' \
			"$sym" "$expected" "$actual" "${from[$sym]}" >&2
		bad=1
	fi
done < <(printf '%s\n' "${!want[@]}" | sort)

if (( bad )); then
	exit 1
fi
echo "all settings set up (checked: ${#want[@]})"

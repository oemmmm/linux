#!/bin/bash
# Проверяет, что ядро приняло все значения из добавок к настройкам.
#
#   check-config путь/к/.config добавка.config...
#
# Добавки читаются по порядку, и для каждой опции действует последнее
# значение (как при make leksos_defconfig leksos.config leksos-game.config).
# Если опция переименована, пропала или не прошла по зависимостям, значение
# в .config не совпадёт с добавкой — тогда скрипт перечисляет такие опции
# и завершается с кодом 1.
set -euo pipefail

if (( $# < 2 )); then
	echo "использование: $0 .config добавка.config..." >&2
	exit 2
fi

config=$1
shift

parse() {
	# Печатает «ОПЦИЯ ЗНАЧЕНИЕ» для каждой опции файла; «is not set» — это n.
	local line
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $line =~ ^(CONFIG_[A-Za-z0-9_]+)=(.*)$ ]]; then
			printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
		elif [[ $line =~ ^#\ (CONFIG_[A-Za-z0-9_]+)\ is\ not\ set$ ]]; then
			printf '%s n\n' "${BASH_REMATCH[1]}"
		fi
	done < "$1"
}

declare -A want from have
for fragment in "$@"; do
	while read -r sym value; do
		want[$sym]=$value
		from[$sym]=${fragment##*/}
	done < <(parse "$fragment")
done
while read -r sym value; do
	have[$sym]=$value
done < <(parse "$config")

bad=0
while read -r sym; do
	expected=${want[$sym]}
	actual=${have[$sym]:-n}
	if [[ $expected != "$actual" ]]; then
		if (( ! bad )); then
			echo "ядро не приняло настройки:" >&2
		fi
		printf '  %s: нужно %s, получилось %s (%s)\n' \
			"$sym" "$expected" "$actual" "${from[$sym]}" >&2
		bad=1
	fi
done < <(printf '%s\n' "${!want[@]}" | sort)

if (( bad )); then
	exit 1
fi
echo "настройки в порядке (проверено опций: ${#want[@]})"
